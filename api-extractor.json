{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/index.d.ts",
  "compiler": {
    "overrideTsconfig": {
      "extends": "./tsconfig.json",
      "compilerOptions": {
        "paths": {
          "@/*": ["./dist/*"]
        }
      }
    }
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "mivabyte-ui.api.md",
    "reportFolder": "<projectFolder>/etc/api",
    "reportTempFolder": "<projectFolder>/.artifacts/api"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "compilerMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    },
    "extractorMessageReporting": {
      "default": {
        "logLevel": "warning"
      },
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "ae-forgotten-export": {
        "logLevel": "error"
      }
    },
    "tsdocMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    }
  }
}
